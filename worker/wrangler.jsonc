{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow-ai-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "vars": {
    "FLOW_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  },
  "ratelimits": [
    {
      "name": "FLOW_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "FLOW_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
